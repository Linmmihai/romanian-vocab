    "script": "(() => { const userId = '87118dba-a11a-4232-bcff-c60c046428a4'; const keys = Object.keys(localStorage).filter(k => k.includes(userId) && /progress|daily_queue|daily_seen_words|daily_log|goal/i.test(k)).sort(); const data = { exportedAt: new Date().toISOString(), userId, url: location.href, keys: {}, keyList: keys }; for (const key of keys) { try { data.keys[key] = JSON.parse(localStorage.getItem(key)); } catch { data.keys[key] = localStorage.getItem(key); } } const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' }); const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = `romanian-vocab-local-progress-${userId}-${new Date().toISOString().replace(/[:.]/g, '-')}.json`; a.click(); })();"
